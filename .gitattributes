# New prose and non-frozen source retain a stable LF representation.
*.md text eol=lf
*.json text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.ps1 text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Frozen receipts hash these historical source and protocol bytes. Preserve
# them on every platform instead of applying checkout or check-in conversion.
protocols/** -text
src/data/mechanism*.py -text
src/experiments/audit_mechanism*.py -text
src/experiments/bind_mechanism*.py -text
src/experiments/discover_mechanism*.py -text
src/experiments/download_mechanism*.py -text
src/experiments/e9_mechanism*.py -text
src/experiments/freeze_mechanism*.py -text
src/experiments/mechanism_v2*.py -text
src/experiments/test_mechanism*.py -text
src/experiments/verify_mechanism*.py -text
src/methods/mechanism_v2.py -text
src/methods/strict_*.py -text
tests/test_mechanism*.py -text

# Dataset and rendered assets must never undergo text conversion.
*.h5 binary
*.hdf5 binary
*.npy binary
*.npz binary
*.png binary
*.pdf binary
*.zip binary
*.part binary

# This paper has an explicit source/build hash closure.  These two protocol
# inputs deliberately override the historical protocol preservation rule so
# their Git bytes and release-worktree bytes are canonical LF.
paper/main.tex text eol=lf
paper/sections/*.tex text eol=lf
paper/refs.bib text eol=lf
paper/NEGATIVE_RESULT_BOUNDARY_*.json text eol=lf
protocols/strict_evaluation_v1.json text eol=lf
protocols/mechanism_v2_6_invalidation_receipt.json text eol=lf
results/e7_strict_codec_benchmark_v1.json text eol=lf
results/e8_cold_start_alarm_v1.json text eol=lf
